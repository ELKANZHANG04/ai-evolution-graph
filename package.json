{
  "name": "ai-evolution-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 演进图谱 —— 用块面积感知 AI 发展节奏的知识面板",
  "scripts": {
    "dev": "tsx scripts/build-data.ts && vite",
    "build": "tsx scripts/build-data.ts && tsc --noEmit && vite build && tsx scripts/build-seo-pages.ts && node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "data:build": "tsx scripts/build-data.ts",
    "validate": "tsx scripts/validate.ts",
    "validate:strict": "tsx scripts/validate.ts --strict",
    "add-entry": "tsx scripts/add-entry.ts",
    "remove-entry": "tsx scripts/remove-entry.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:ui": "node scripts/qa/check-ui.mjs",
    "ai:links": "tsx scripts/ai-links.ts",
    "curate": "tsx scripts/curate.ts",
    "curate:apply": "tsx scripts/curate.ts --apply",
    "seo": "node scripts/build-sitemap.mjs",
    "seo:pages": "tsx scripts/build-seo-pages.ts",
    "seo:push": "node scripts/baidu-push.mjs",
    "build:clean": "rm -rf src/generated dist && npm run build"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "echarts": "^6.1.0",
    "gray-matter": "^4.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
